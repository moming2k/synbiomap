# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# OpenAlex optional credentials.
# - Email: enables the "polite pool" for slightly faster responses.
# - API key: free account at https://openalex.org gives 10,000 filtered
#   queries/day and 1,000 full-text searches/day. Passed as ?api_key=...
OPENALEX_EMAIL=your.email@example.com
OPENALEX_API_KEY=your_openalex_api_key_here

# Patent data. The pipeline uses the USPTO Open Data Portal (ODP) as the
# authoritative source, with PatentsView as an alternate/supplementary client.
# ODP key:        https://data.uspto.gov  (free, key required)
# PatentsView key: https://patentsview.org/apis  (free, key required)
USPTO_ODP_KEY=your_uspto_odp_key_here
PATENTSVIEW_API_KEY=your_patentsview_key_here

# Anthropic API key — used to draft cluster topic labels with Claude Haiku.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: HuggingFace token (needed if using gated models)
HF_TOKEN=your_huggingface_token_here

# Geocoding provider (default: Nominatim, which is free)
# If using OpenCage: https://opencagedata.com/
OPENCAGE_API_KEY=your_opencage_key_here

# NCBI API key for increased rate limit
# get one at ncbi.nlm.nih.gov/account

NCBI_API_KEY=yourkey

# Optional LLM for iGEM expression-failure extraction
# (scripts/03e_scrape_expression_failures.py). Any OpenAI-compatible
# chat-completions server works. Leave the key blank to use the built-in
# heuristic instead, which needs no network beyond the wiki crawl itself.
# IGEM_* names take priority; OPENAI_* are accepted as aliases.
IGEM_LLM_API_KEY=
IGEM_LLM_BASE_URL=https://api.openai.com/v1
IGEM_LLM_MODEL=gpt-4o-mini